# Copy to .env and fill in from Supabase: Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the web version is hosted, used for shareable booking links
# (e.g. https://potongku.app). Leave empty to use app links instead.
EXPO_PUBLIC_WEB_URL=

# The PotongKu team's WhatsApp number (e.g. 012-345 6789), which barbers
# message from "Keep my shop live" to subscribe when their free month runs out.
EXPO_PUBLIC_SUPPORT_WHATSAPP=
